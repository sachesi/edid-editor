<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.sachesi.EdidEditor</id>
  <name>EDID Editor</name>
  <summary>Edit display identification data</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      EDID Editor inspects and edits EDID (Extended Display Identification
      Data) structures. It supports EDID v1.3+ base blocks, CTA-861
      extensions, and DisplayID data blocks. A visual timing editor and
      synchronized byte view make structured changes easier to inspect.
    </p>
    <p>
      EDID Editor is based on wxEDID by Tomasz Pawlak.
    </p>
  </description>
  <developer id="io.github.sachesi">
    <name>sachesi</name>
  </developer>
  <launchable type="desktop-id">io.github.sachesi.EdidEditor.desktop</launchable>
  <translation type="gettext">edid-editor</translation>
  <url type="homepage">https://github.com/sachesi/edid-editor</url>
  <url type="bugtracker">https://github.com/sachesi/edid-editor/issues</url>
  <url type="vcs-browser">https://github.com/sachesi/edid-editor</url>
  <provides>
    <binary>edid-editor</binary>
    <binary>edid-editor-cli</binary>
  </provides>
  <releases>
    <release version="0.3.0" date="2026-09-15">
      <description>
        <p>
          Adds edid-editor-cli, which reads, edits, compares and converts EDID
          data from a terminal with the same code as the editor. It sets
          fields by their plain names, sets a refresh rate through the pixel
          clock, adds, duplicates, moves and deletes data blocks, prints JSON,
          and comes with a manual page and completions for bash, zsh and fish.
          It builds without GTK.
        </p>
        <p>
          The timing diagram labels its sync, porch and total sizes, and typing
          a refresh rate sets the pixel clock. An EDID log and notes on the
          Overview replace the details panel, and every page fits from phone to
          desktop widths. Decodes DisplayID Adaptive Sync descriptors and names
          the signal formats of the supported features. The application can now
          be translated.
        </p>
      </description>
    </release>
    <release version="0.2.0" date="2026-09-14">
      <description>
        <p>
          Adds structural CTA-861 and DisplayID editing with Undo and Redo,
          safe audio and timing templates, hexadecimal import and export, text
          reports, opening of damaged EDID data, and field-level validation
          feedback. Decodes HDMI Forum, AMD FreeSync, and DisplayID 2.0 timing
          and range data, parses every CTA-861 extension, and opens the EDID
          of a connected display. Shows HDR luminance in cd/m², range limits
          above 255 Hz, native video formats, and standard timing names.
        </p>
        <p>
          Adds an overview of the whole EDID, comparison with a file or a
          connected display, recent files, file drag and drop, on/off switches
          for single bits, plain field names with full descriptions, hidden
          reserved fields, and marking of a field’s bytes.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-11">
      <description>
        <p>
          Initial GTK application with structured field editing, visual timing
          controls, search, byte inspection, and Undo and Redo support.
        </p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1" />
</component>
